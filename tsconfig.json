{
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    // TypeScript 7 does not pick @types/node up on its own here.
    "types": ["node"],
    // Node runs the report by stripping its types, which checks nothing and
    // refuses nothing it cannot erase. This is the flag that says so: an enum or
    // a parameter property here fails the typecheck instead of the run.
    "erasableSyntaxOnly": true,
    // `profiler.aggregate.test.ts` imports its subject by a `.ts` specifier —
    // the one spelling Node's type stripping, vitest and tsx all resolve.
    "allowImportingTsExtensions": true
  },
  // The `.mjs` modules the package exports are absent from this program: a
  // directory glob drops a `.mjs` when a `.d.mts` of the same name sits beside
  // it. `tsconfig.build.json` globs `*.mjs` alone, checks them, and writes
  // those declarations. `pnpm run typecheck` runs both.
  //
  // `scripts`, and only `scripts`: `fixtures/bench.e2e` is a React app with its
  // own tsconfig, compiled by vite and by nothing here. Keeping it outside this
  // `include` is what keeps `.tsx` out of this program — no `exclude` needed.
  "include": ["scripts"]
}
