{
  "name": "@abernier/skills",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "files": [
    "scripts/bench.common.sh",
    "scripts/bench.config.d.mts",
    "scripts/bench.config.mjs",
    "scripts/bench.config.sh",
    "scripts/bench.conformance.test.ts",
    "scripts/bench.launch.sh",
    "scripts/bench.lgtm.sh",
    "scripts/bench.playwright.d.mts",
    "scripts/bench.playwright.mjs",
    "scripts/bench.tests.d.mts",
    "scripts/bench.tests.mjs",
    "scripts/bench.types.d.mts",
    "scripts/gestures.d.mts",
    "scripts/gestures.mjs",
    "scripts/profiler.aggregate.sh",
    "scripts/profiler.aggregate.ts",
    "scripts/profiler.compare.sh",
    "scripts/profiler.compare.ts",
    "scripts/profiler.scan.injected.ts",
    "scripts/profiler.scan.setup.d.mts",
    "scripts/profiler.scan.setup.mjs",
    "scripts/profiler.sh",
    "scripts/tracerbench.compare.sh",
    "scripts/tracerbench.compare.ts",
    "scripts/tracerbench.sh"
  ],
  "bin": {
    "tracerbench": "./scripts/tracerbench.sh",
    "profiler": "./scripts/profiler.sh",
    "lgtm-perf": "./scripts/bench.lgtm.sh",
    "tracerbench-compare": "./scripts/tracerbench.compare.sh",
    "profiler-compare": "./scripts/profiler.compare.sh",
    "profiler-aggregate": "./scripts/profiler.aggregate.sh"
  },
  "exports": {
    "./bench-tests": {
      "types": "./scripts/bench.tests.d.mts",
      "default": "./scripts/bench.tests.mjs"
    },
    "./bench-types": {
      "types": "./scripts/bench.types.d.mts"
    },
    "./gestures": {
      "types": "./scripts/gestures.d.mts",
      "default": "./scripts/gestures.mjs"
    },
    "./profiler-scan": {
      "types": "./scripts/profiler.scan.setup.d.mts",
      "default": "./scripts/profiler.scan.setup.mjs"
    },
    "./playwright": {
      "types": "./scripts/bench.playwright.d.mts",
      "default": "./scripts/bench.playwright.mjs"
    }
  },
  "packageManager": "pnpm@10.33.4",
  "description": "Toolchain for the plugin's own scripts. The plugin itself installs nothing.",
  "scripts": {
    "changeset": "changeset",
    "fixture": "vite fixtures/app",
    "changeset:version": "changeset version && node scripts/sync-plugin-version.mts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.build.json --noEmit",
    "types:emit": "tsc -p tsconfig.build.json",
    "types:check": "rm -rf node_modules/.cache/skills-dts && tsc -p tsconfig.build.json --outDir node_modules/.cache/skills-dts && for f in node_modules/.cache/skills-dts/scripts/*.d.mts; do diff -u \"scripts/${f##*/}\" \"$f\" || exit 1; done",
    "lint": "shellcheck --severity=warning scripts/branchstat.sh scripts/branchstat.test.sh scripts/release-tag.sh scripts/bench.common.sh scripts/bench.common.test.sh scripts/bench.config.sh scripts/bench.config.test.sh scripts/bench.launch.sh scripts/bench.lgtm.sh scripts/profiler.sh scripts/profiler.test.sh scripts/bench.e2e.test.sh scripts/LGTM.sh scripts/profiler.aggregate.sh scripts/profiler.compare.sh scripts/tracerbench.sh scripts/tracerbench.compare.sh",
    "test": "bash scripts/branchstat.test.sh && bash scripts/bench.common.test.sh && bash scripts/bench.config.test.sh && bash scripts/profiler.test.sh && vitest run",
    "lgtm": "pnpm run typecheck && pnpm run types:check && pnpm run lint && pnpm run test && echo 'LGTM!'",
    "LGTM": "bash scripts/LGTM.sh"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.49"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "bippy": "^0.5.43",
    "esbuild": "^0.28.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
