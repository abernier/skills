{
  "name": "@abernier/skills",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "description": "Toolchain for the plugin's own scripts. The plugin itself installs nothing.",
  "scripts": {
    "changeset": "changeset",
    "changeset:version": "changeset version && node scripts/sync-plugin-version.mts",
    "typecheck": "tsc --noEmit",
    "lint": "shellcheck --severity=warning scripts/branchstat.sh scripts/branchstat.test.sh scripts/release-tag.sh",
    "test": "bash scripts/branchstat.test.sh",
    "lgtm": "pnpm run typecheck && pnpm run lint && pnpm run test && echo 'LGTM!'"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
