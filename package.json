{
  "name": "@abernier/skills",
  "version": "0.6.1",
  "private": true,
  "type": "module",
  "files": [
    "scripts",
    "!scripts/branchstat*",
    "!scripts/release-tag.sh",
    "!scripts/sync-plugin-version.mts"
  ],
  "bin": {
    "tracerbench": "./scripts/tracerbench.sh",
    "profiler": "./scripts/profiler.sh",
    "lgtm-perf": "./scripts/bench.lgtm.sh",
    "tracerbench-compare": "./scripts/tracerbench.compare.sh",
    "profiler-compare": "./scripts/profiler.compare.sh",
    "profiler-aggregate": "./scripts/profiler.aggregate.sh"
  },
  "exports": {
    "./bench-tests": {
      "types": "./scripts/bench.tests.d.mts",
      "default": "./scripts/bench.tests.mjs"
    },
    "./bench-types": {
      "types": "./scripts/bench.types.d.mts"
    },
    "./gestures": {
      "types": "./scripts/gestures.d.mts",
      "default": "./scripts/gestures.mjs"
    },
    "./profiler-scan": {
      "types": "./scripts/profiler.scan.setup.d.mts",
      "default": "./scripts/profiler.scan.setup.mjs"
    },
    "./playwright": {
      "types": "./scripts/bench.playwright.d.mts",
      "default": "./scripts/bench.playwright.mjs"
    }
  },
  "packageManager": "pnpm@10.33.4",
  "description": "Toolchain for the plugin's own scripts. The plugin itself installs nothing.",
  "scripts": {
    "changeset": "changeset",
    "changeset:version": "changeset version && node scripts/sync-plugin-version.mts",
    "typecheck": "tsc --noEmit",
    "lint": "shellcheck --severity=warning scripts/branchstat.sh scripts/branchstat.test.sh scripts/release-tag.sh scripts/bench.common.sh scripts/bench.common.test.sh scripts/bench.config.sh scripts/bench.config.test.sh scripts/bench.launch.sh scripts/bench.lgtm.sh scripts/profiler.sh scripts/profiler.aggregate.sh scripts/profiler.compare.sh scripts/tracerbench.sh scripts/tracerbench.compare.sh",
    "test": "bash scripts/branchstat.test.sh && bash scripts/bench.common.test.sh && bash scripts/bench.config.test.sh && vitest run",
    "lgtm": "pnpm run typecheck && pnpm run lint && pnpm run test && echo 'LGTM!'"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.49"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "bippy": "^0.5.43",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
